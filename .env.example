# Physics MCQ Examination Portal — Environment Configuration

# Application Port and Environment
APP_ENV=production
PORT=3000
NODE_ENV=production

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_service_role_key_here"

# Client Vite bindings
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"

# Security & CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
